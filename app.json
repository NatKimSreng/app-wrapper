{
  "expo": {
    "name": "BuildHubKH",
    "slug": "buildhubkh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#23517c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.buildhubkh.mobile",
      "infoPlist": {
        "NSBonjourServices": [
          "_http._tcp",
          "_https._tcp",
          "_http._tcp",
          "_https._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Connect to local services",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.14657723180-madlraoqa21n8a9f7ei9chigcu0uhpbm"
            ]
          }
        ]
      },
      "scheme": "buildhubkh"
    },
    "android": {
      "package": "com.buildhubkh.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#23517c"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "buildhubkh.com",
            "pathPrefix": "/"
          }
        },
        {
          "action": "VIEW",
          "data": {
            "scheme": "buildhubkh",
            "pathPrefix": "/"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "buildhubkh",
    "plugins": [
      [
        "expo-router",
        {
          "origin": false,
          "asyncRoutes": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0e05ea3f-c6fd-4d4f-a532-85a2b948c912"
      },
      "googleClientId": {
        "ios": "14657723180-madlraoqa21n8a9f7ei9chigcu0uhpbm.apps.googleusercontent.com",
        "android": "14657723180-5jf640lfagjht1i8ssgbhuft020rk7io.apps.googleusercontent.com"
      },
      "backendUrl": "https://api.buildhubkh.com"
    }
  }
}
