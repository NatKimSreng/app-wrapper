{
  "name": "buildhubkh-mobile",
  "version": "1.0.0",
  "description": "BuildHubKH mobile app WebView wrapper",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "build:android": "eas build --platform android --profile apk",
    "build:ios": "eas build --platform ios",
    "preview:android": "eas build --platform android --profile preview",
    "preview:ios": "eas build --platform ios --auto-submit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "expo": "^54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.4",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.3.0"
  },
  "private": true
}
