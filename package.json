{
  "name": "buildhubkh-mobile",
  "version": "1.0.0",
  "description": "BuildHubKH mobile app WebView wrapper",
  "main": "expo-app.json",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "preview:android": "eas build --platform android --auto-submit",
    "preview:ios": "eas build --platform ios --auto-submit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-auth-session": "^5.4.0",
    "expo-web-browser": "^14.0.0",
    "expo-notifications": "^0.28.0",
    "expo-device": "^6.1.0",
    "expo-constants": "^16.0.0",
    "expo-linking": "^7.0.0",
    "react": "^18.3.0",
    "react-native": "^0.76.0",
    "react-native-webview": "^14.5.0",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "^4.1.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.76.0",
    "typescript": "^5.6.0"
  },
  "private": true
}
